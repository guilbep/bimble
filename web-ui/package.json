{
  "name": "bimble-web-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "i18n-keys": "node scripts/i18n-keys.mjs",
    "typecheck": "node scripts/i18n-keys.mjs --check && vue-tsc --noEmit",
    "prebuild": "node scripts/i18n-keys.mjs",
    "build": "vite build",
    "perf": "node perf/lighthouse.mjs",
    "perf:check": "node perf/check.mjs ../perf-results/web.txt perf/budgets.txt 0.15",
    "design-check": "node design-check/compare.mjs",
    "e2e:place": "node e2e/place-slab.mjs --lab",
    "e2e:a11y": "node e2e/a11y.mjs --lab"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
