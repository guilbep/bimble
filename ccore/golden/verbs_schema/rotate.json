{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Arguments of `rotate`.",
  "properties": {
    "about": {
      "description": "Centre [x, y], mm; default: the centre of the elements' placement origins.",
      "items": {
        "format": "double",
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": [
        "array",
        "null"
      ]
    },
    "angle_deg": {
      "description": "Angle, degrees, counter-clockwise seen from above; |angle| ≤ 360.",
      "format": "double",
      "type": "number"
    },
    "ids": {
      "description": "GlobalIds of the elements.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "ids",
    "angle_deg"
  ],
  "title": "RotateArgs",
  "type": "object"
}
