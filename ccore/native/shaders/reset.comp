#version 450
// Before the cull: every command's instance count to 0 (the counters too).
layout(local_size_x = 64) in;
layout(std430, set = 1, binding = 0) buffer FaceCmds { uint fcmd[]; };
layout(std430, set = 1, binding = 1) buffer EdgeCmds { uint ecmd[]; };
layout(std430, set = 1, binding = 2) buffer Counters { uint counter[]; };
layout(set = 2, binding = 0) uniform Reset { uvec4 n; }; // x: face commands, y: edge commands
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < n.x) fcmd[i * 5u + 1u] = 0u;
    if (i < n.y) ecmd[i * 4u + 1u] = 0u;
    if (i < 4u) counter[i] = 0u;
}
