ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('booleans fixture'),'2;1');
FILE_NAME('booleans.ifc','2026-11-05',(''),(''),'bimble','bimble','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCCARTESIANPOINT((0.,0.,0.));
#4=IFCAXIS2PLACEMENT3D(#3,$,$);
#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);
#6=IFCPROJECT('0YvctVUKr0kugbFTf53O9L',$,'p',$,$,$,$,(#5),#2);
#7=IFCLOCALPLACEMENT($,#4);
#10=IFCCARTESIANPOINT((0.,0.));
#11=IFCAXIS2PLACEMENT2D(#10,$);
#12=IFCDIRECTION((0.,0.,1.));
#20=IFCRECTANGLEPROFILEDEF(.AREA.,$,#11,1000.,400.);
#21=IFCEXTRUDEDAREASOLID(#20,#4,#12,3000.);
/* 1. Column clipped by a tilted plane: keep the side the normal points to (AgreementFlag .T.) */
#30=IFCCARTESIANPOINT((0.,0.,2000.));
#31=IFCDIRECTION((0.5,0.,-1.));
#32=IFCAXIS2PLACEMENT3D(#30,#31,$);
#33=IFCPLANE(#32);
#34=IFCHALFSPACESOLID(#33,.T.);
#35=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#21,#34);
#36=IFCSHAPEREPRESENTATION(#5,'Body','Clipping',(#35));
#37=IFCPRODUCTDEFINITIONSHAPE($,$,(#36));
#38=IFCBUILDINGELEMENTPROXY('1YvctVUKr0kugbFTf53O9L',$,'clipped',$,$,#7,#37,$,$);
/* 2. Same column, polygonal bounded half-space removing only one corner region */
#40=IFCCARTESIANPOINT((0.,0.,2500.));
#41=IFCAXIS2PLACEMENT3D(#40,$,$);
#42=IFCPLANE(#41);
#43=IFCCARTESIANPOINT((0.,0.,0.));
#44=IFCAXIS2PLACEMENT3D(#43,$,$);
#45=IFCCARTESIANPOINT((0.,0.));
#46=IFCCARTESIANPOINT((600.,0.));
#47=IFCCARTESIANPOINT((600.,300.));
#48=IFCCARTESIANPOINT((0.,300.));
#49=IFCPOLYLINE((#45,#46,#47,#48,#45));
#50=IFCPOLYGONALBOUNDEDHALFSPACE(#42,.F.,#44,#49);
#51=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#21,#50);
#52=IFCSHAPEREPRESENTATION(#5,'Body','Clipping',(#51));
#53=IFCPRODUCTDEFINITIONSHAPE($,$,(#52));
#54=IFCBUILDINGELEMENTPROXY('2YvctVUKr0kugbFTf53O9L',$,'polygonal',$,$,#7,#53,$,$);
/* 3. Solid difference: a 200 mm cylinder through the column */
#60=IFCCIRCLEPROFILEDEF(.AREA.,$,#11,100.);
#61=IFCCARTESIANPOINT((0.,-500.,1500.));
#62=IFCDIRECTION((0.,1.,0.));
#63=IFCAXIS2PLACEMENT3D(#61,#62,$);
#64=IFCEXTRUDEDAREASOLID(#60,#63,#12,1000.);
#65=IFCBOOLEANRESULT(.DIFFERENCE.,#21,#64);
#66=IFCSHAPEREPRESENTATION(#5,'Body','CSG',(#65));
#67=IFCPRODUCTDEFINITIONSHAPE($,$,(#66));
#68=IFCBUILDINGELEMENTPROXY('3YvctVUKr0kugbFTf53O9L',$,'drilled',$,$,#7,#67,$,$);
/* 4. Wall with a door opening (IfcRelVoidsElement) */
#70=IFCRECTANGLEPROFILEDEF(.AREA.,$,#11,6000.,200.);
#71=IFCEXTRUDEDAREASOLID(#70,#4,#12,2800.);
#72=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#71));
#73=IFCPRODUCTDEFINITIONSHAPE($,$,(#72));
#74=IFCCARTESIANPOINT((0.,5000.,0.));
#75=IFCAXIS2PLACEMENT3D(#74,$,$);
#76=IFCLOCALPLACEMENT(#7,#75);
#77=IFCWALL('4YvctVUKr0kugbFTf53O9L',$,'wall',$,$,#76,#73,$,$);
#80=IFCRECTANGLEPROFILEDEF(.AREA.,$,#11,1200.,400.);
#81=IFCEXTRUDEDAREASOLID(#80,#4,#12,2100.);
#82=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#81));
#83=IFCPRODUCTDEFINITIONSHAPE($,$,(#82));
#84=IFCCARTESIANPOINT((-1000.,0.,0.));
#85=IFCAXIS2PLACEMENT3D(#84,$,$);
#86=IFCLOCALPLACEMENT(#76,#85);
#87=IFCOPENINGELEMENT('5YvctVUKr0kugbFTf53O9L',$,'door',$,$,#86,#83,$,.OPENING.);
#88=IFCRELVOIDSELEMENT('6YvctVUKr0kugbFTf53O9L',$,$,$,#77,#87);
/* 5. Polygonal bounded half-space whose boundary is no closed polygon: a composite curve with
   its arcs around the column and its lines far away (seen in Revit exports). Cut by the
   plane z = 2500 alone, as IfcOpenShell 0.9 does. */
#90=IFCCARTESIANPOINT((0.,0.));
#91=IFCAXIS2PLACEMENT2D(#90,$);
#92=IFCCIRCLE(#91,2000.);
#93=IFCCIRCLE(#91,2200.);
#94=IFCTRIMMEDCURVE(#92,(IFCPARAMETERVALUE(90.)),(IFCPARAMETERVALUE(170.)),.T.,.PARAMETER.);
#95=IFCTRIMMEDCURVE(#93,(IFCPARAMETERVALUE(90.)),(IFCPARAMETERVALUE(170.)),.T.,.PARAMETER.);
#96=IFCCARTESIANPOINT((0.,500000.));
#97=IFCCARTESIANPOINT((0.,540000.));
#98=IFCPOLYLINE((#96,#97));
#99=IFCCARTESIANPOINT((-40000.,0.));
#100=IFCPOLYLINE((#99,#90));
#101=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.F.,#94);
#102=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#98);
#103=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#95);
#104=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#100);
#105=IFCCOMPOSITECURVE((#101,#102,#103,#104),.F.);
#106=IFCPOLYGONALBOUNDEDHALFSPACE(#42,.F.,#44,#105);
#107=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#21,#106);
#108=IFCSHAPEREPRESENTATION(#5,'Body','Clipping',(#107));
#109=IFCPRODUCTDEFINITIONSHAPE($,$,(#108));
#110=IFCBUILDINGELEMENTPROXY('7YvctVUKr0kugbFTf53O9L',$,'broken boundary',$,$,#7,#109,$,$);
/* 6. The same with a polyline that doesn't come back to its first point: not closed either,
   cut by the plane alone (IfcOpenShell 0.9 too) */
#120=IFCPOLYLINE((#45,#46,#47,#48));
#121=IFCPOLYGONALBOUNDEDHALFSPACE(#42,.F.,#44,#120);
#122=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#21,#121);
#123=IFCSHAPEREPRESENTATION(#5,'Body','Clipping',(#122));
#124=IFCPRODUCTDEFINITIONSHAPE($,$,(#123));
#125=IFCBUILDINGELEMENTPROXY('8YvctVUKr0kugbFTf53O9L',$,'open polyline',$,$,#7,#124,$,$);
ENDSEC;
END-ISO-10303-21;
